                Player.Character.Humanoid.Health = 0
                Player.CharacterAdded:Wait()
                task.wait(1.5)
            end
            resetting, bag_full = false, false
        end
    end)

    -- // Loop do Farm (Deitado + Teletransporte Curto)
    task.spawn(function()
        while true do
            if noclipEnabled and autoFarmEnabled then
                autoFarmEnabled = false
                ToggleCircle.BackgroundColor3 = Theme.Off
                if Player.Character and Player.Character:FindFirstChild("Humanoid") then
                    Player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end

            if autoFarmEnabled and farming and not bag_full then
                local coin, dist = get_nearest_coin()
                if coin then
                    local hrp = getHRP()
                    
                    -- 🌟 TELETRANSPORTE PARA NÃO BUGAR DEITADO
                    if dist > 150 then
                        hrp.CFrame = coin.CFrame
                    elseif dist > 20 then
                        local tw = TweenService:Create(hrp, TweenInfo.new((dist - 15) / farmSpeed, Enum.EasingStyle.Linear), {CFrame = coin.CFrame})
                        tw:Play()
                        task.wait((dist - 15) / farmSpeed)
                    else
                        hrp.CFrame = coin.CFrame
                    end
                    
                    -- Espera a moeda ser coletada
                    local tempo = 0
                    repeat 
                        task.wait() 
                        tempo = tempo + 0.05
                    until not coin:FindFirstChild("TouchInterest") or not farming or not autoFarmEnabled or tempo > 1
                end
            end
            task.wait(0.1)
        end
    end)

