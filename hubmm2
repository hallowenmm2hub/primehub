    Instance.new("UICorner", KeyButton).CornerRadius = UDim.new(0, 6)

    local KeyStatus = Instance.new("TextLabel", KeyFrame)
    KeyStatus.BackgroundTransparency = 1
    KeyStatus.Position = UDim2.new(0, 0, 0.85, 0)
    KeyStatus.Size = UDim2.new(1, 0, 20, 0)
    KeyStatus.Font = Enum.Font.Gotham
    KeyStatus.Text = ""
    KeyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
    KeyStatus.TextSize = 12

    KeyButton.MouseButton1Click:Connect(function()
        if KeyInput.Text == VALID_KEY then
            KeyStatus.Text = "Acesso Liberado!"
            KeyStatus.TextColor3 = Color3.fromRGB(120, 255, 120)
            SaveKey()
            task.wait(1)
            LoadHub()
        else
            KeyStatus.Text = "Key incorreta. Tente novamente."
            KeyStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end)
end
