-- // AUTO WIN
local function checkRole()
    local p = Player
    for _, v in pairs(ReplicatedStorage:FindFirstChild("Roles"):GetChildren()) do
        if v.Value == p.Name then return v.Name end
    end
    return "Innocent"
end

ReplicatedStorage.Remotes.Gameplay.CoinCollected.OnClientEvent:Connect(function(_, current, max)
    if current == max and autoWin then
        task.spawn(function()
            local role = checkRole()
            local hrp = getHRP()
            if role == "Murderer" then
                local knife = Player.Character:FindFirstChild("Knife") or Player.Backpack:FindFirstChild("Knife")
                if knife then Player.Character.Humanoid:EquipTool(knife) end
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.Humanoid.Health > 0 then
                        hrp.CFrame = p.Character.HumanoidRootPart.CFrame
                        task.wait(0.2)
                    end
                end
            elseif role == "Sheriff" then
                local gun = Player.Character:FindFirstChild("Gun") or Player.Backpack:FindFirstChild("Gun")
                if gun then Player.Character.Humanoid:EquipTool(gun) end
                for _, v in pairs(ReplicatedStorage.Roles:GetChildren()) do
                    if v.Name == "Murderer" then
                        local m = Players:FindFirstChild(v.Value)
                        if m and m.Character then
                            hrp.CFrame = m.Character.HumanoidRootPart.CFrame
                            task.wait(0.2)
                            if gun then gun:Activate() end
                        end
                    end
                end
            end
        end)
    end
end)

-- // FLY LOOP
task.spawn(function()
    while task.wait(0.1) do
        if autoFarm and farming then
            local char = Player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            
            if char and hum and hum.Health > 0 then
                local coin = getCoin()
                local hrp = getHRP()
                
                if coin and hrp then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                    
                    local dist = (hrp.Position - coin.Position).Magnitude
                    local tTime = math.max(dist / speed, 0.3)
                    
                    local tween = TweenService:Create(hrp, TweenInfo.new(tTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(coin.Position)})
                    tween:Play()
                    
                    repeat task.wait() until not coin:FindFirstChild("TouchInterest") or not autoFarm or not farming
                    pcall(function() tween:Cancel() end)
                end
            end
        end
    end
end)

-- // DRAG UI
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

