-- 🔁 FARM LOGIC
-------------------------------------------------------------------
local function getCharacter() return Player.Character or Player.CharacterAdded:Wait() end
local function getHRP() return getCharacter():WaitForChild("HumanoidRootPart") end

local function updateCoinCache()
	cachedCoins = {}
	for _, m in pairs(workspace:GetChildren()) do
		if m:FindFirstChild("CoinContainer") then
			for _, coin in pairs(m.CoinContainer:GetChildren()) do
				if coin:IsA("BasePart") and coin:FindFirstChild("TouchInterest") then
					table.insert(cachedCoins, coin)
				end
			end
		end
	end
end

local function getNearestCoin()
	local hrp = getHRP()
	if not hrp then return nil end
	local closest, dist = nil, math.huge
	for _, coin in pairs(cachedCoins) do
		if coin.Parent and coin:FindFirstChild("TouchInterest") then
			local d = (hrp.Position - coin.Position).Magnitude
			if d < dist then closest, dist = coin, d end
		end
	end
	return closest, dist
end

local function getMyRole()
    local char = Player.Character
    local backpack = Player:FindFirstChild("Backpack")
    local roleFolder = ReplicatedStorage:FindFirstChild("Roles")
    if roleFolder then
        local m, s = roleFolder:FindFirstChild("Murderer"), roleFolder:FindFirstChild("Sheriff")
        if m and m.Value == Player.Name then return "Murderer" end
        if s and s.Value == Player.Name then return "Sheriff" end
    end
    if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then return "Murderer" end
    if (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then return "Sheriff" end
    return "Innocent"
end

