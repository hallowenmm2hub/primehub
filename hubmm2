-- // Funções de salvamento da Key
local function CheckSavedKey()
    local success, result = pcall(function()
        if isfile and isfile(KEY_FILE) then
            local savedTime = tonumber(readfile(KEY_FILE))
            if savedTime and (os.time() - savedTime) < TIME_24H then
                return true
            else
                delfile(KEY_FILE)
            end
        end
        return false
    end)
    return success and result
end

local function SaveKey()
    pcall(function()
        if writefile then
            writefile(KEY_FILE, tostring(os.time()))
        end
    end)
end

