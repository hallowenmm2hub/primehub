-- // LÓGICA DO SCRIPT (LOOPS)
local function getHRP() return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") end

local function getCoin()
    local hrp = getHRP()
    if not hrp then return nil end
    local closest, dist = nil, math.huge
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v:FindFirstChild("TouchInterest") then
            local name = string.lower(v.Name)
            if string.find(name, "coin") or string.find(name, "candy") or v.Parent.Name == "CoinContainer" then
                local d = (hrp.Position - v.Position).Magnitude
                if d < dist then closest, dist = v, d end
            end
        end
    end
    return closest
end

local function getRole()
    local char = Player.Character
    local backpack = Player:FindFirstChild("Backpack")
    local roles = ReplicatedStorage:FindFirstChild("Roles")
    if roles then
        local m, s = roles:FindFirstChild("Murderer"), roles:FindFirstChild("Sheriff")
        if m and m.Value == Player.Name then return "Murderer" end
        if s and s.Value == Player.Name then return "Sheriff" end
    end
    if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then return "Murderer" end
    if (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then return "Sheriff" end
    return "Innocent"
end

-- Loop do Farm
task.spawn(function()
    while task.wait(0.1) do
        if States.AutoFarm then
            local char = Player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            if char and hum and hum.Health > 0 then
                local coin = getCoin()
                local hrp = getHRP()
                if coin and hrp then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                    local dist = (hrp.Position - coin.Position).Magnitude
                    local tTime = math.max(dist / tonumber(SpeedBox.Text), 0.3)
                    local tween = TweenService:Create(hrp, TweenInfo.new(tTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(coin.Position)})
                    tween:Play()
                    repeat task.wait() until not coin:FindFirstChild("TouchInterest") or not States.AutoFarm
                    pcall(function() tween:Cancel() end)
                end
            end
        end
    end
end)

