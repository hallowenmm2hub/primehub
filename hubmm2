ReplicatedStorage:WaitForChild("Remotes").Gameplay.RoundStart.OnClientEvent:Connect(function()
	farming = true
	start_position = getHRP().CFrame
	updateCoinCache()
end)

ReplicatedStorage.Remotes.Gameplay.RoundEndFade.OnClientEvent:Connect(function()
	farming = false
	if start_position then getHRP().CFrame = start_position end
end)

ReplicatedStorage.Remotes.Gameplay.CoinCollected.OnClientEvent:Connect(function(_, current, max)
    coinStats.sessionCoins = coinStats.sessionCoins + 1
    local timeElapsed = tick() - coinStats.sessionStart
    if timeElapsed > 1 then
        local coinsPerSecond = coinStats.sessionCoins / timeElapsed
        CoinRateLabel.Text = string.format("💰 %d/h  •  %d/min  •  %d total", math.floor(coinsPerSecond * 3600), math.floor(coinsPerSecond * 60), coinStats.sessionCoins)
    end
    
    task.delay(0.5, updateCoinCache)

    if current == max and not resetting then
        resetting = true; bag_full = true
        
        if autoWinEnabled then
            task.spawn(function()
                local myRole, hrp, char = getMyRole(), getHRP(), Player.Character
                if myRole == "Murderer" then
                    local knife = char:FindFirstChild("Knife") or Player.Backpack:FindFirstChild("Knife")
                    if knife and knife.Parent == Player.Backpack then char.Humanoid:EquipTool(knife) end
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.Humanoid.Health > 0 then
                            hrp.CFrame = p.Character.HumanoidRootPart.CFrame
                            task.wait(0.2)
                        end
                    end
                elseif myRole == "Sheriff" then
                    local gun = char:FindFirstChild("Gun") or Player.Backpack:FindFirstChild("Gun")
                    if gun and gun.Parent == Player.Backpack then char.Humanoid:EquipTool(gun) end
                    local roleFolder = ReplicatedStorage:FindFirstChild("Roles")
                    if roleFolder and roleFolder:FindFirstChild("Murderer") then
                        local m = Players:FindFirstChild(roleFolder.Murderer.Value)
                        if m and m.Character and m.Character:FindFirstChild("HumanoidRootPart") then
                            hrp.CFrame = m.Character.HumanoidRootPart.CFrame
                            task.wait(0.2); if gun then gun:Activate() end
                        end
                    end
                end
            end)
        end

        if autoResetEnabled then
            local hrp = getHRP()
            if start_position then
                local tween = TweenService:Create(hrp, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = start_position})
                tween:Play(); tween.Completed:Wait()
            end
            task.wait(0.5)
            if Player.Character and Player.Character:FindFirstChild("Humanoid") then
                Player.Character.Humanoid.Health = 0
                Player.CharacterAdded:Wait(); task.wait(1.5)
            end
        end
        resetting = false; bag_full = false
    end
end)

-- 🌟 LOOP DO FARM (SEM TP - USANDO WALKSPEED E MOVETO)
task.spawn(function()
	while true do
		if autoFarmEnabled and farming and not bag_full then
			local coin, dist = getNearestCoin()
			local char = Player.Character
			
			if coin and char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
				-- Manda o personagem CORRER até a moeda (Movimento Seguro)
				char.Humanoid:MoveTo(coin.Position)
				
				-- Se estiver longe, dá um pulo para não travar em rampas
				if dist > 15 then
					char.Humanoid.Jump = true
				end
			else
				updateCoinCache()
			end
		end
		task.wait(0.1)
	end
end)

