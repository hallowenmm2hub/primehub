-- // Função para checar se a Key ainda é válida (menos de 24h)
local function CheckSavedKey()
    local success, result = pcall(function()
        if isfile and isfile(KEY_FILE) then
            local savedTime = tonumber(readfile(KEY_FILE))
            if savedTime then
                local currentTime = os.time()
                if (currentTime - savedTime) < TIME_24H then
                    return true -- Ainda é válida
                else
                    delfile(KEY_FILE) -- Expirou, deleta o arquivo
                end
            end
        end
        return false
    end)
    return success and result
end

-- // Função para salvar a Key
local function SaveKey()
    pcall(function()
        if writefile then
            writefile(KEY_FILE, tostring(os.time()))
        end
    end)
end

