local function AplicarCor(inst, prop, tipo)
    table.insert(UIElements, {obj = inst, prop = prop, tipo = tipo})
    inst[prop] = TemaAtual[tipo]
end

local function TrocarTema(NomeTema)
    TemaAtual = Temas[NomeTema]
    for _, item in pairs(UIElements) do
        if item.obj and item.obj.Parent then
            item.obj[item.prop] = TemaAtual[item.tipo]
        end
    end
end

