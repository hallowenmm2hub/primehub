-- Loop do ESP
task.spawn(function()
    while task.wait(1) do
        if States.ESP then
            local murdererName, sheriffName
            local roles = ReplicatedStorage:FindFirstChild("Roles")
            if roles then
                murdererName = roles:FindFirstChild("Murderer") and roles.Murderer.Value
                sheriffName = roles:FindFirstChild("Sheriff") and roles.Sheriff.Value
            end
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= Player and p.Character then
                    local char = p.Character
                    local color = Color3.fromRGB(0, 255, 0)
                    if p.Name == murdererName then color = Color3.fromRGB(255, 0, 0)
                    elseif p.Name == sheriffName then color = Color3.fromRGB(0, 100, 255) end
                    
                    local esp = char:FindFirstChild("ArkeESP")
                    if not esp then
                        esp = Instance.new("Highlight", char)
                        esp.Name = "ArkeESP"
                        esp.Adornee = char
                        esp.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        esp.FillTransparency = 0.6
                    end
                    esp.FillColor = color
                    esp.OutlineColor = color
                end
            end
        end
    end
end)

-- Loop do KillAura
task.spawn(function()
    while task.wait(1) do
        if States.KillAura then
            local role = getRole()
            local hrp = getHRP()
            local char = Player.Character
            
            if role == "Murderer" and hrp and char then
                local knife = char:FindFirstChild("Knife") or Player.Backpack:FindFirstChild("Knife")
                if knife then char.Humanoid:EquipTool(knife) end
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.Humanoid.Health > 0 then
                        hrp.CFrame = p.Character.HumanoidRootPart.CFrame
                        task.wait(0.3)
                    end
                end
            elseif role == "Sheriff" and hrp and char then
                local gun = char:FindFirstChild("Gun") or Player.Backpack:FindFirstChild("Gun")
                if gun then char.Humanoid:EquipTool(gun) end
                local roles = ReplicatedStorage:FindFirstChild("Roles")
                if roles and roles:FindFirstChild("Murderer") then
                    local m = Players:FindFirstChild(roles.Murderer.Value)
                    if m and m.Character and m.Character:FindFirstChild("HumanoidRootPart") then
                        hrp.CFrame = m.Character.HumanoidRootPart.Position
                        task.wait(0.2)
                        if gun then gun:Activate() end
                    end
                end
            end
        end
    end
end)

