    -- // Farm Logic
    local function getHRP() return (Player.Character or Player.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart") end
    local function get_nearest_coin()
        local hrp, closest, dist = getHRP(), nil, math.huge
        for _, m in pairs(workspace:GetChildren()) do
            if m:FindFirstChild("CoinContainer") then
                for _, coin in pairs(m.CoinContainer:GetChildren()) do
                    if coin:IsA("BasePart") and coin:FindFirstChild("TouchInterest") then
                        local d = (hrp.Position - coin.Position).Magnitude
                        if d < dist then closest, dist = coin, d end
                    end
                end
            end
        end
        return closest, dist
    end

    ReplicatedStorage:WaitForChild("Remotes").Gameplay.RoundStart.OnClientEvent:Connect(function() farming = true; start_position = getHRP().CFrame end)
    ReplicatedStorage.Remotes.Gameplay.RoundEndFade.OnClientEvent:Connect(function() farming = false; if start_position then getHRP().CFrame = start_position end end)

    -- // Auto Reset Normal
    ReplicatedStorage.Remotes.Gameplay.CoinCollected.OnClientEvent:Connect(function(_, current, max)
        if current == max and not resetting and autoResetEnabled then
            resetting, bag_full = true, true
            local hrp = getHRP()
            if start_position then
                local tw = TweenService:Create(hrp, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = start_position})
                tw:Play(); tw.Completed:Wait()
            end
            task.wait(0.5)
            if Player.Character and Player.Character:FindFirstChild("Humanoid") then
                Player.Character.Humanoid.Health = 0
                Player.CharacterAdded:Wait(); task.wait(1.5)
            end
            resetting, bag_full = false, false
        end
    end)

    -- // Loop do Farm Normal
    task.spawn(function()
        while true do
            if autoFarmEnabled and farming and not bag_full then
                local coin, dist = get_nearest_coin()
                if coin then
                    local hrp = getHRP()
                    
                    if dist > 150 then
                        hrp.CFrame = CFrame.new(coin.Position)
                    else
                        local tw = TweenService:Create(hrp, TweenInfo.new(dist / farmSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(coin.Position)})
                        tw:Play()
                        repeat task.wait() until not coin:FindFirstChild("TouchInterest") or not farming or not autoFarmEnabled
                        pcall(function() tw:Cancel() end)
                    end
                end
            end
            task.wait(0.1)
        end
    end)

