-- // Loop do Role ESP
task.spawn(function()
	while true do
		task.wait(1) -- Atualiza a cada 1 segundo
		if roleESPEnabled then
			-- Procura as funções internas do jogo ou usa o nome do jogador
			local murderer = nil
			local sheriff = nil
			
			-- Tenta usar a função do jogo (se existir)
			if _G.findMurderer then
				local ok, result = pcall(_G.findMurderer)
				if ok then murderer = result end
			end
			if _G.findSheriff then
				local ok, result = pcall(_G.findSheriff)
				if ok then sheriff = result end
			end
			
			for _, p in pairs(Players:GetPlayers()) do
				if p ~= Player and p.Character then
					local char = p.Character
					if not char:FindFirstChild("RoleESP") then
						local highlight = Instance.new("Highlight")
						highlight.Name = "RoleESP"
						highlight.Parent = char
						highlight.Adornee = char
						highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						highlight.FillTransparency = 0.6
						highlight.OutlineTransparency = 0
						
						-- Define a cor baseada no papel
						local roleColor = Color3.fromRGB(0, 255, 0) -- Verde (Inocente)
						if p == murderer then
							roleColor = Color3.fromRGB(255, 0, 0) -- Vermelho (Assassino)
						elseif p == sheriff then
							roleColor = Color3.fromRGB(0, 100, 255) -- Azul (Xerife)
						end
						
						highlight.FillColor = roleColor
						highlight.OutlineColor = roleColor
					end
				end
			end
		end
	end
end)

