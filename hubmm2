                        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            getHRP().CFrame = p.Character.HumanoidRootPart.CFrame
                            task.wait(0.15)
                        end
                    end
                elseif myRole == "Sheriff" then
                    local murdererName
                    local roleFolder = ReplicatedStorage:FindFirstChild("Roles")
                    if roleFolder and roleFolder:FindFirstChild("Murderer") then murdererName = roleFolder.Murderer.Value end
                    if murdererName then
                        local murderer = Players:FindFirstChild(murdererName)
                        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                            getHRP().CFrame = murderer.Character.HumanoidRootPart.CFrame
                            local gun = Player.Character:FindFirstChild("Gun") or Player.Backpack:FindFirstChild("Gun")
                            if gun then
                                if gun.Parent == Player.Backpack then Player.Character.Humanoid:EquipTool(gun) end
                                task.wait(0.1); gun:Activate()
                            end
                        end
                    end
                end
            end

            if Config.autoResetEnabled then
                resetting, bag_full = true, true
                local hrp = getHRP()
                if start_position then
                    local tw = TweenService:Create(hrp, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = start_position})
                    tw:Play(); tw.Completed:Wait()
                end
                task.wait(0.5)
                if Player.Character and Player.Character:FindFirstChild("Humanoid") then
                    Player.Character.Humanoid.Health = 0
                    Player.CharacterAdded:Wait(); task.wait(1.5)
                end
                resetting, bag_full = false, false
            end
        end
    end)

    -- // Loop do Farm
    task.spawn(function()
        while true do
            if not ScreenGui or not ScreenGui.Parent then break end -- Fecha se a UI for destruída
            if Config.autoFarmEnabled and farming and not bag_full then
                local coin, dist = get_nearest_coin()
                if coin then
                    local hrp = getHRP()
                    local targetCF = CFrame.new(coin.Position)
                    
                    if Config.lieDownEnabled then
                        targetCF = CFrame.new(coin.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                    end

                    if dist > 150 then
                        hrp.CFrame = targetCF
                    else
                        local tw = TweenService:Create(hrp, TweenInfo.new(dist / Config.farmSpeed, Enum.EasingStyle.Linear), {CFrame = targetCF})
                        tw:Play()
                        repeat task.wait() until not coin:FindFirstChild("TouchInterest") or not farming or not Config.autoFarmEnabled
                        pcall(function() tw:Cancel() end)
                    end
                end
            end
            task.wait(0.1)
        end
    end)

    -- // Role ESP
    task.spawn(function()
        while true do
            task.wait(1.5)
            if not ScreenGui or not ScreenGui.Parent then break end -- Fecha se a UI for destruída
            if Config.roleESPEnabled then
                local murdererName, sheriffName
                local roleFolder = ReplicatedStorage:FindFirstChild("Roles")
                if roleFolder then
                    murdererName = roleFolder:FindFirstChild("Murderer") and roleFolder.Murderer.Value
                    sheriffName = roleFolder:FindFirstChild("Sheriff") and roleFolder.Sheriff.Value
                end
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= Player and p.Character then
                        local char = p.Character
                        local roleColor = Color3.fromRGB(0, 255, 0)
                        if p.Name == murdererName then roleColor = Color3.fromRGB(255, 0, 0)
                        elseif p.Name == sheriffName then roleColor = Color3.fromRGB(0, 100, 255)
                        else
                            local backpack = p:FindFirstChild("Backpack")
                            local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
                            local hasGun = (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun")
                            if hasKnife then roleColor = Color3.fromRGB(255, 0, 0)
                            elseif hasGun then roleColor = Color3.fromRGB(0, 100, 255) end
                        end
                        
                        local esp = char:FindFirstChild("RoleESP")
                        if not esp then
                            esp = Instance.new("Highlight"); esp.Name = "RoleESP"; esp.Parent = char; esp.Adornee = char; esp.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; esp.FillTransparency = 0.6; esp.OutlineTransparency = 0
                        end
                        esp.FillColor = roleColor; esp.OutlineColor = roleColor
                    end
                end
            end
        end
    end)

    -- // Arrastar a Janela Principal
    local dragging, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    MainFrame.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- // Botão Flutuante Arrastável
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Parent = ScreenGui
    ToggleButton.Size = UDim2.new(0, 50, 0, 50)
    ToggleButton.Position = UDim2.new(0.06, 0, 0.12, 0)
    ToggleButton.BackgroundColor3 = Theme.Background
    ToggleButton.Text = "👑"
    ToggleButton.TextColor3 = Theme.Accent
    ToggleButton.Font = Enum.Font.GothamBold
    ToggleButton.TextSize = 24
    ToggleButton.AutoButtonColor = false
    Instance.new("UICorner", ToggleButton).CornerRadius = UDim.new(1, 0)
    local BtnStroke = Instance.new("UIStroke", ToggleButton); BtnStroke.Color = Theme.Accent; BtnStroke.Thickness = 1.5; BtnStroke.Transparency = 0.3

    local draggingButton = false
    local dragStartButton, startPosButton
    local buttonWasDragged = false

    ToggleButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingButton = true; buttonWasDragged = false
            dragStartButton = input.Position; startPosButton = ToggleButton.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then draggingButton = false end end)
        end
    end)

    ToggleButton.InputChanged:Connect(function(input)
        if draggingButton and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStartButton
            if delta.Magnitude > 5 then buttonWasDragged = true end
            ToggleButton.Position = UDim2.new(startPosButton.X.Scale, startPosButton.X.Offset + delta.X, startPosButton.Y.Scale, startPosButton.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingButton and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStartButton
            if delta.Magnitude > 5 then buttonWasDragged = true end
            ToggleButton.Position = UDim2.new(startPosButton.X.Scale, startPosButton.X.Offset + delta.X, startPosButton.Y.Scale, startPosButton.Y.Offset + delta.Y)
        end
    end)

    local isVisible = true
    ToggleButton.MouseButton1Click:Connect(function()
        if not buttonWasDragged then
            isVisible = not isVisible
            MainFrame.Visible = isVisible
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == Enum.KeyCode.H then
            isVisible = not isVisible
            MainFrame.Visible = isVisible
        end
    end)
end

